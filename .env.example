# ---- Caristo : variables d'environnement ----
# Base de données (SQLite en local ; Postgres en production : postgresql://...)
DATABASE_URL="file:./dev.db"

# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Mode démonstration : true = données fictives réalistes, paiement simulé, aucun compte externe requis
DEMO_MODE="true"

# Clé secrète utilisée pour signer les liens de partage et les sessions
APP_SECRET="change-me-32-characters-minimum-please"

# ---- Fournisseur d'identification par plaque / VIN (quand DEMO_MODE=false) ----
PLATE_PROVIDER="apiplaque"          # apiplaque | mock
PLATE_API_KEY=""
PLATE_API_URL="https://api.apiplaqueimmatriculation.com"   # laisser tel quel

# ---- Historique officiel (quand DEMO_MODE=false) ----
HISTORY_PROVIDER="none"             # none | auto
HISTORY_API_URL=""

# ---- Paiement Stripe (quand DEMO_MODE=false) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SINGLE=""              # price_... pour 19,90 €
STRIPE_PRICE_PACK3=""               # price_... pour 49,90 €
STRIPE_PRICE_PACK10=""              # price_... pour 129,90 €

# ---- E-mails (Resend) ----
RESEND_API_KEY=""
EMAIL_FROM="Caristo <rapports@votre-domaine.fr>"

# ---- Analyse d'annonce par IA (facultatif) ----
ANTHROPIC_API_KEY=""
CRON_SECRET=""
